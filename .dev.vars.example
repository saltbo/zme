# Copy to .dev.vars for local development. Also the source of binding/var names
# for `wrangler types` (pnpm cf-typegen), so keep the keys here in sync.

# Required external OIDC relying-party configuration. ZME derives the callback,
# logout, and resource-server URLs from PUBLIC_APP_ORIGIN.
PUBLIC_APP_ORIGIN=http://localhost:7171
OIDC_ISSUER=https://identity.example/tenant
OIDC_CLIENT_ID=zme-local
OIDC_ADMIN_SUBJECTS=local-admin-subject

# Required for encrypting third-party connector sessions at rest.
CONNECTOR_CREDENTIALS_SECRET=replace-with-an-independent-32-character-secret

# Required for one-hour, user-bound encrypted release candidate references.
DOWNLOAD_RESOURCE_REF_SECRET=replace-with-another-independent-32-character-secret

# Streams MP3/FLAC files through ZME only when standard music tags need to be added or corrected.
MUSIC_AUTO_TAGGING_ENABLED=false

# Optional local browser fixture subject:
# LOCAL_TEST_SUBJECT=local-admin-subject
#
# Optional deployment-only values are documented in docs/oidc-deployment.md:
# OIDC_CLIENT_SECRET, OIDC_TOKEN_ENDPOINT_AUTH_METHOD, and
# OIDC_LEGACY_BINDINGS_JSON. Do not add them to a normal public-client setup.
#
# TMDB and Prowlarr are configured inside the app (Admin -> Media sources / Indexers),
# not via environment variables.
