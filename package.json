{
  "name": "zme",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply zme --local",
    "db:migrate:remote": "wrangler d1 migrations apply zme --remote",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p src/tsconfig.json",
    "test": "vitest run",
    "test:ci": "mkdir -p reports && vitest run --reporter=default --reporter=json --outputFile=reports/vitest.json && tsx scripts/verify-quality-inventory.ts --vitest-report=reports/vitest.json",
    "test:coverage": "vitest run --project unit --coverage",
    "test:coverage:task": "vitest run --project unit --coverage --coverage.thresholds.statements=0 && tsx scripts/check-changed-unit-coverage.ts",
    "test:music-tags": "node scripts/verify-music-tags.mjs",
    "test:watch": "vitest",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:ci": "mkdir -p reports && PLAYWRIGHT_JSON_OUTPUT_NAME=reports/playwright.json node scripts/run-e2e.mjs --reporter=line,json && tsx scripts/verify-quality-inventory.ts --playwright-report=reports/playwright.json",
    "e2e:provider": "node scripts/fake-oidc-provider.mjs",
    "e2e:server": "wrangler d1 migrations apply zme --local --persist-to \"$E2E_PERSIST\" && vite dev --port \"$E2E_APP_PORT\"",
    "lint": "biome check .",
    "lint:arch": "depcruise server/ shared/ src/ --config .dependency-cruiser.cjs",
    "openapi:lint": "tsx scripts/lint-openapi.ts",
    "openapi:diff": "tsx scripts/check-openapi-semantic-diff.ts",
    "openapi:baseline:update": "tsx scripts/check-openapi-semantic-diff.ts --update",
    "quality:inventory": "tsx scripts/verify-quality-inventory.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "openapi:zpan": "node scripts/gen-zpan-client.mjs",
    "cf-typegen": "wrangler types server/worker-configuration.d.ts --include-runtime=false --env-file .dev.vars.example",
    "postinstall": "wrangler types server/worker-configuration.d.ts --include-runtime=false --env-file .dev.vars.example",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@hono/zod-validator": "^0.7.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.101.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "i18next": "^26.3.1",
    "jose": "6.2.8",
    "lucide-react": "^0.577.0",
    "oauth4webapi": "3.8.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "react-router": "^7.16.0",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "taglib-wasm": "1.5.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@cloudflare/vite-plugin": "^1.42.2",
    "@cloudflare/vitest-pool-workers": "^0.16.19",
    "@cloudflare/workers-types": "^4.20260623.1",
    "@hey-api/openapi-ts": "^0.98.1",
    "@playwright/test": "^1.60.0",
    "@redocly/cli": "2.44.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "msw": "^2.14.6",
    "music-metadata": "11.14.0",
    "tailwindcss": "^4.2.4",
    "tsx": "4.20.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.104.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "workerd"
    ],
    "patchedDependencies": {
      "taglib-wasm@1.5.2": "patches/taglib-wasm@1.5.2.patch"
    }
  },
  "volta": {
    "node": "24.14.1",
    "pnpm": "10.30.2"
  }
}
